// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MovementType {
  IN
  OUT

  @@map("movement_type")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED

  @@map("appointment_status")
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(120)
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  products    Product[]

  @@map("categories")
}

model Product {
  id          String               @id @default(uuid()) @db.Uuid
  name        String               @db.VarChar(200)
  description String?              @db.Text
  sku         String               @unique @db.VarChar(100)
  price       Decimal              @db.Decimal(12, 2)
  stock       Int                  @default(0)
  minStock    Int                  @default(0) @map("min_stock")
  categoryId  String               @map("category_id") @db.Uuid
  category    Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  movements   InventoryMovement[]
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([categoryId])
  @@index([name])
  @@index([stock, minStock])
  @@map("products")
}

model InventoryMovement {
  id          String       @id @default(uuid()) @db.Uuid
  productId   String       @map("product_id") @db.Uuid
  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  type        MovementType
  quantity    Int
  description String?      @db.VarChar(255)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([productId, createdAt])
  @@index([type, createdAt])
  @@map("inventory_movements")
}

model Clinic {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(120)
  address   String   @db.VarChar(200)
  phone     String   @db.VarChar(30)
  email     String?  @db.VarChar(120)
  specialty String?  @db.VarChar(120)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  items        ClinicInventoryItem[]
  patients     ClinicPatient[]
  appointments Appointment[]

  @@index([active])
  @@map("clinics")
}

model ClinicInventoryItem {
  id          String   @id @default(uuid()) @db.Uuid
  clinicId    String   @map("clinic_id") @db.Uuid
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name        String   @db.VarChar(120)
  sku         String?  @db.VarChar(60)
  quantity    Int      @default(0)
  minStock    Int      @default(0) @map("min_stock")
  unit        String?  @db.VarChar(20)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([clinicId, name])
  @@index([clinicId, name])
  @@map("clinic_inventory_items")
}

model ClinicPatient {
  id           String        @id @default(uuid()) @db.Uuid
  clinicId     String        @map("clinic_id") @db.Uuid
  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name         String        @db.VarChar(120)
  document     String?       @db.VarChar(30)
  phone        String        @db.VarChar(30)
  email        String?       @db.VarChar(120)
  birthDate    DateTime?     @map("birth_date") @db.Date
  notes        String?       @db.VarChar(500)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  appointments Appointment[]

  @@unique([clinicId, document])
  @@index([clinicId, name])
  @@map("clinic_patients")
}

model Appointment {
  id              String                @id @default(uuid()) @db.Uuid
  clinicId        String                @map("clinic_id") @db.Uuid
  clinic          Clinic                @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId       String                @map("patient_id") @db.Uuid
  patient         ClinicPatient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  scheduledAt     DateTime              @map("scheduled_at") @db.Timestamptz(6)
  durationMinutes Int                   @default(30) @map("duration_minutes")
  reason          String                @db.VarChar(255)
  status          AppointmentStatus     @default(PENDING)
  notes           String?               @db.VarChar(1000)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  comments        AppointmentComment[]

  @@index([clinicId, scheduledAt])
  @@index([patientId, scheduledAt])
  @@map("appointments")
}

model AppointmentComment {
  id            String      @id @default(uuid()) @db.Uuid
  appointmentId String      @map("appointment_id") @db.Uuid
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  author        String      @db.VarChar(80)
  body          String      @db.VarChar(1000)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([appointmentId, createdAt])
  @@map("appointment_comments")
}
