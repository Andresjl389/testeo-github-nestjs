# Plantilla únicamente. Inyectar estos valores como secretos de la plataforma;
# no crear archivos .env con credenciales reales dentro del repositorio.
NODE_ENV=production
DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST:5432/inventory_management?schema=public&sslmode=require"
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=log
SWAGGER_ENABLED=true
